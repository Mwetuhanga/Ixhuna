# Copy to .env and fill in. The defaults below run a local test environment:
# Postgres + Redis from docker-compose.yml, and the WhatsApp simulator on
# instead of real WhatsApp.

# --- Server ---
PORT=3000
# Long random string in any shared or production environment.
JWT_SECRET=change-me-to-a-long-random-string
# Origins allowed to call the API from a browser (e.g. your website with the
# complaint form). "*" allows any.
CORS_ORIGIN=*
# Set when behind a load balancer or reverse proxy (e.g. 1 for one hop).
# TRUST_PROXY=1

# --- Database and queue (match docker-compose.yml) ---
DATABASE_URL=postgresql://support_bot:support_bot@localhost:5432/support_bot
REDIS_HOST=localhost
REDIS_PORT=6379

# --- First admin agent, created by `npm run seed` ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me
ADMIN_SEED_NAME=Admin

# --- WhatsApp ---
# true: chat with the bot at /whatsapp-simulator instead of real WhatsApp.
# Every outgoing WhatsApp message then goes to the simulator, and anyone who
# can open the page can chat as any number, so NEVER use true where real
# customers use the bot.
WHATSAPP_SIMULATOR=true
# Real WhatsApp Cloud API (see "Testing the WhatsApp bot" in the README).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Recommended: verifies that webhook calls really come from Meta.
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v20.0

# --- Website complaint form ---
# Complaints accepted per IP address per window.
# WEB_FORM_RATE_LIMIT=10
# WEB_FORM_RATE_WINDOW_SECONDS=600
# Country code assumed for phone numbers typed without one (264 = Namibia).
# DEFAULT_COUNTRY_CODE=264

# --- Email notifications (leave SMTP_HOST empty to skip sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM_EMAIL=complaints@example.com
# Staff inbox that receives new complaints and handover requests.
NOTIFY_TO_EMAIL=

# --- AI suggested replies for agents ---
# "echo" (default, no external calls) or "anthropic".
AI_PROVIDER=echo
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
